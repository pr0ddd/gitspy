{
  "name": "gitspy",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/pr0ddd/gitspy.git"
  },
  "version": "1.1.2",
  "description": "A free, open-source desktop git client: commit graph, staging, diffs and a merge conflict editor, in a native app.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "i18n:check": "node scripts/check-locales.mjs",
    "build": "npm run i18n:check && npm run boundary:check && npm run notices:check && npm run format:check && npm run lint && tsc --noEmit && vitest run && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "boundary:check": "node scripts/check-boundary.mjs",
    "test": "vitest run",
    "lint": "node --test eslint-rules/fsd-boundaries.test.mjs eslint-rules/fsd-public-api.test.mjs && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:check": "license-checker --production --excludePrivatePackages --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;MPL-2.0;OFL-1.1;(MIT OR Apache-2.0);(Apache-2.0 OR MIT);(MPL-2.0 OR Apache-2.0);MIT OR Apache-2.0;Apache-2.0 OR MIT'",
    "notices": "node scripts/third-party.mjs",
    "notices:check": "node scripts/third-party.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "monaco-editor": "^0.56.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "license-checker": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "typescript-eslint": "^8.66.0",
    "vite": "^7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
