{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitspy",
  "version": "1.1.1",
  "identifier": "dev.gitspy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitspy",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost https:; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/avatars/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/pr0ddd/gitspy/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MDMzNjIzRjZERkU0NEQKUldSTjVOLzJJellEUmcvbUFmbEdyNXJMMjVmRnh1byswTzYzVDdJNkxmUERYenprQ2xFNkJLNHMK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Pavel Erohovets",
    "copyright": "© 2026 Pavel Erohovets",
    "category": "DeveloperTool",
    "shortDescription": "A free, open-source git client",
    "longDescription": "Commit graph, staging, diffs, a merge conflict editor and GitHub, GitLab and Bitbucket sign-in, in a native app.",
    "homepage": "https://github.com/pr0ddd/gitspy",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY.md": "THIRD-PARTY.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
