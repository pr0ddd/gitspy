{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitspy",
  "version": "1.0.6",
  "identifier": "dev.gitspy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitspy",
        "width": 1400,
        "height": 900,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: http://asset.localhost; worker-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/avatars/*"]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/pr0ddd/gitspy/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MDMzNjIzRjZERkU0NEQKUldSTjVOLzJJellEUmcvbUFmbEdyNXJMMjVmRnh1byswTzYzVDdJNkxmUERYenprQ2xFNkJLNHMK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: <name> (<team id>)",
      "hardenedRuntime": true
    }
  }
}
