{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitspy",
  "version": "0.1.0",
  "identifier": "dev.gitspy.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "gitspy",
        "width": 1400,
        "height": 900
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/avatars/*"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
